{
  "containerDefinitions": [
    {
      "name": "enrolment-api",
      "image": "000000000000.dkr.ecr.us-east-1.localhost:5100/usms-enrolment:r7",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ],
  "family": "usms-enrolment",
  "taskRoleArn": "arn:aws:iam::000000000000:role/usms-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::000000000000:role/usms-ecs-exec-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "1024"
}