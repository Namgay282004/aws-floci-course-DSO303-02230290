{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListTranscriptsPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::usms-student-data",
      "Condition": {
        "StringLike": { "s3:prefix": "transcripts/*" }
      }
    },
    {
      "Sid": "AllowReadTranscriptObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::usms-student-data/transcripts/*"
    },
    {
      "Sid": "DenyWriteAndDeleteOnBucket",
      "Effect": "Deny",
      "Action": ["s3:Put*", "s3:Delete*"],
      "Resource": "arn:aws:s3:::usms-student-data/*"
    }
  ]
}
