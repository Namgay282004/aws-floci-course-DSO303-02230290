{
"Version": "2012-10-17",
"Statement": [
{
  "Sid": "AllowPassRoleToUSMSServiceRolesOnly",
  "Effect": "Allow",
  "Action": "iam:PassRole",
  "Resource": [
    "arn:aws:iam::000000000000:role/usms-ec2-*",
    "arn:aws:iam::000000000000:role/usms-ecs-*",
    "arn:aws:iam::000000000000:role/usms-lambda-*"
  ],
  "Condition": {
    "StringEquals": {
      "iam:PassedToService": [
        "ec2.amazonaws.com",
        "ecs-tasks.amazonaws.com",
        "lambda.amazonaws.com"
      ]
    }
  }
}
]
}
